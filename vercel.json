{
  "cleanUrls": true,
  "redirects": [
    { "source": "/korisiq", "destination": "/korislab/", "permanent": true },
    { "source": "/korisiq/:path*", "destination": "/korislab/", "permanent": true },
    { "source": "/brio", "destination": "/", "permanent": true },
    { "source": "/brio/:path*", "destination": "/", "permanent": true },
    { "source": "/openslot", "destination": "/", "permanent": true },
    { "source": "/openslot/:path*", "destination": "/", "permanent": true },
    { "source": "/spire-coach-mod", "destination": "/", "permanent": true },
    { "source": "/spire-coach-mod/:path*", "destination": "/", "permanent": true },
    { "source": "/desk-experiment.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
